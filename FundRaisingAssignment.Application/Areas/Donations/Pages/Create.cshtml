@page "{campaignId:guid}"
@model FundRaisingAssignment.Application.Areas.Donations.Pages.CreateModel
@{
    ViewData["Title"] = "Make a Donation";
}

<h1>Make a Donation</h1>

@if (Model.Campaign != null)
{
    <div class="mb-3">
        <strong>Campaign:</strong> @Model.Campaign.Title
    </div>
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form method="post">
    <div class="mb-3">
        <label asp-for="Input.Amount" class="form-label">Amount</label>
        <input asp-for="Input.Amount" class="form-control" type="number" min="0.01" step="0.01" required />
        <span asp-validation-for="Input.Amount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Message" class="form-label">Message (optional)</label>
        <textarea asp-for="Input.Message" class="form-control"></textarea>
        <span asp-validation-for="Input.Message" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Input.IsAnonymous" class="form-check-input" type="checkbox" />
        <label asp-for="Input.IsAnonymous" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Donate</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
