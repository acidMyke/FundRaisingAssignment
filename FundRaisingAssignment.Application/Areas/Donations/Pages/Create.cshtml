@page "{campaignId:guid}"
@model FundRaisingAssignment.Application.Areas.Donations.Pages.CreateModel
@{
    ViewData["Title"] = "Make a Donation";
}


<h1>Make a Donation</h1>

@if (TempData["Debug"] != null)
{
    <div style="color:red">@TempData["Debug"]</div>
}

@if (Model.Campaign != null)
{
    <div class="mb-3">
        <strong>Campaign:</strong> @Model.Campaign.Title
    </div>
}

<form method="post">
    <div class="mb-3">
        <label asp-for="Donation.Amount" class="form-label">Amount</label>
        <input asp-for="Donation.Amount" class="form-control" type="number" min="1" step="0.01" required />
        <span asp-validation-for="Donation.Amount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Donation.PaymentMethod" class="form-label">Payment Method</label>
        <select asp-for="Donation.PaymentMethod" class="form-control">
            <option>Credit Card</option>
            <option>PayPal</option>
            <option>Bank Transfer</option>
        </select>
        <span asp-validation-for="Donation.PaymentMethod" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Donation.Notes" class="form-label">Notes (optional)</label>
        <textarea asp-for="Donation.Notes" class="form-control"></textarea>
        <span asp-validation-for="Donation.Notes" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Donate</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
