@model List<FundRaisingAssignment.Application.Models.ViewModels.DigestUserGroupViewModel>

@if (Model.Count > 0)
{
    <div class="accordion" id="accordionUsers">
        @foreach (var userGroup in Model)
        {
            var collapseId = $"collapse-{userGroup.UserId}";
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-@userGroup.UserId">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                        <div class="d-flex w-100 justify-content-between align-items-center me-3">
                            <div>
                                <i class="bi bi-person-circle me-2"></i><strong>@userGroup.UserName</strong> 
                                <span class="text-muted small ms-1">(@userGroup.UserEmail)</span>
                            </div>
                            <div>
                                <span class="badge bg-light text-dark border me-1" title="Email ID">
                                    <i class="bi bi-envelope"></i> @userGroup.DisplayEmailId
                                </span>
                                <span class="badge @userGroup.EmailStatusBadgeClass me-1">@userGroup.DisplayEmailStatus</span>
                                
                                @if (!string.IsNullOrEmpty(userGroup.EmailReason))
                                {
                                    <span class="badge bg-danger" title="Reason">@userGroup.EmailReason</span>
                                }
                            </div>
                        </div>
                    </button>
                </h2>
                <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="heading-@userGroup.UserId" data-bs-parent="#accordionUsers">
                    <div class="accordion-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Campaign Title</th>
                                    <th class="text-end">Affinity Score</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in userGroup.Entries)
                                {
                                    <tr>
                                        <td class="ps-5">
                                            @if (entry.HasCampaign)
                                            {
                                                <i class="bi bi-dot me-1"></i><strong>@(entry.CampaignTitle ?? "Unknown Campaign")</strong>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">No campaigns qualified</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (!entry.IsBypass)
                                            {
                                                <span class="text-success fw-semibold">@entry.DisplayAffinityScore</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@entry.DisplayAffinityScore</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-3"></i>
            <h5>No user entries found</h5>
            <p class="mb-0">This batch does not contain any digest entries.</p>
        </div>
    </div>
}
