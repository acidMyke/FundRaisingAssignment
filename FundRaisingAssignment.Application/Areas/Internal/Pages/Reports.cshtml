@page
@using FundRaisingAssignment.Application.Models
@model FundRaisingAssignment.Application.Areas.Internal.Pages.ReportsModel
@{
    ViewData["Title"] = "Platform reports";
}

@*
    Page bound to ReportsModel.
    Three handlers driven from this form:
        Preview → OnPostPreviewAsync   (renders PreviewReport on screen)
        Export  → OnPostExportAsync    (returns CSV / XLSX file)
*@

<div class="container-fluid py-3">

    <!-- ===================== Header ===================== -->
    <div class="d-flex justify-content-between align-items-end mb-4 pb-3 border-bottom">
        <div>
            <small class="text-uppercase text-muted fw-semibold">User Admin</small>
            <h2 class="mt-2 mb-1">Platform performance &amp; financial reports</h2>
            <p class="text-muted mb-0">
                Aggregate campaign and donation activity over a date range, then export as CSV or Excel.
            </p>
        </div>
    </div>

    <!-- ===================== Flash message ===================== -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ===================== Export success card (sub-flow 15a) ===================== -->
    @if (Model.SuccessFile is not null)
    {
        var f = Model.SuccessFile;
        var sizeKb = Math.Max(1, (int)Math.Round(f.Size / 1024d));
        <div class="alert alert-success border-success-subtle mb-4" role="alert">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h6 class="mb-1">Export ready for download</h6>
                    <div class="small mb-1">
                        <strong>@f.FileName</strong>
                        <span class="text-muted">&middot; @f.Format &middot; @sizeKb&nbsp;KB</span>
                    </div>
                    <div class="small text-muted">
                        Range @f.RangeStart.ToString("yyyy-MM-dd") &ndash; @f.RangeEnd.ToString("yyyy-MM-dd")
                        &middot; created @f.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC
                        &middot; Export ID <code>@f.Id</code>
                    </div>
                </div>
                <a class="btn btn-success" asp-page-handler="Download" asp-route-id="@f.Id">
                    Download @f.Format
                </a>
            </div>
        </div>
    }

    <div class="row g-4">

        <!-- ===================== Left: filters form ===================== -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white border-bottom-0 pt-3">
                    <h5 class="mb-0">Report range</h5>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <form method="post">
                        <!-- Start date -->
                        <div class="mb-3">
                            <label asp-for="Input.StartDate" class="form-label fw-medium"></label>
                            <input asp-for="Input.StartDate" type="date" class="form-control" />
                            <span asp-validation-for="Input.StartDate" class="text-danger small"></span>
                        </div>

                        <!-- End date -->
                        <div class="mb-3">
                            <label asp-for="Input.EndDate" class="form-label fw-medium"></label>
                            <input asp-for="Input.EndDate" type="date" class="form-control" />
                            <span asp-validation-for="Input.EndDate" class="text-danger small"></span>
                            <div class="form-text">End date is inclusive (whole day counted).</div>
                        </div>

                        <!-- Format -->
                        <div class="mb-4">
                            <label asp-for="Input.Format" class="form-label fw-medium"></label>
                            <select asp-for="Input.Format"
                                    asp-items="Html.GetEnumSelectList<ExportFormat>()"
                                    class="form-select"></select>
                            <div class="form-text">Used by the Export button only.</div>
                        </div>

                        <!-- Action buttons (different page handlers) -->
                        <div class="d-grid gap-2">
                            <button type="submit" asp-page-handler="Preview" class="btn btn-primary">
                                Preview report
                            </button>
                            <button type="submit" asp-page-handler="Export" class="btn btn-success">
                                Export
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- ===================== Right: preview ===================== -->
        <div class="col-lg-8">
            @if (Model.PreviewReport is null)
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center text-muted py-5">
                        <p class="mb-1">No preview yet.</p>
                        <p class="small mb-0">Choose a date range and click <strong>Preview report</strong>.</p>
                    </div>
                </div>
            }
            else
            {
                var r = Model.PreviewReport;
                var jsonOpts = new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                };

                var dailyJson    = System.Text.Json.JsonSerializer.Serialize(
                    r.DailyTotals.Select(d => new {
                        date = d.Date.ToString("yyyy-MM-dd"),
                        donations = d.DonationCount,
                        raised = d.TotalRaised
                    }), jsonOpts);

                var statusJson   = System.Text.Json.JsonSerializer.Serialize(r.ByStatus, jsonOpts);
                var categoryJson = System.Text.Json.JsonSerializer.Serialize(r.ByCategory, jsonOpts);
                var topCampJson  = System.Text.Json.JsonSerializer.Serialize(
                    r.TopCampaigns.Take(10), jsonOpts);
                var paymentJson  = System.Text.Json.JsonSerializer.Serialize(r.ByPaymentMethod, jsonOpts);
                var donorsJson   = System.Text.Json.JsonSerializer.Serialize(
                    r.TopDonors.Take(10), jsonOpts);
                var locationJson = System.Text.Json.JsonSerializer.Serialize(r.ByLocation, jsonOpts);

                <!-- Summary -->
                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <small class="text-uppercase text-muted fw-semibold">Summary</small>
                                <h5 class="mt-1 mb-0">
                                    @r.StartDate.ToString("d MMM yyyy") &ndash; @r.EndDate.ToString("d MMM yyyy")
                                </h5>
                            </div>
                            <small class="text-muted">
                                Generated @r.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC
                            </small>
                        </div>

                        <div class="row g-3">
                            <div class="col-6 col-md-3">
                                <div class="border rounded p-3 h-100">
                                    <small class="text-muted d-block">Total raised</small>
                                    <strong class="fs-5">@r.TotalRaised.ToString("C")</strong>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="border rounded p-3 h-100">
                                    <small class="text-muted d-block">Donations</small>
                                    <strong class="fs-5">@r.TotalDonations.ToString("N0")</strong>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="border rounded p-3 h-100">
                                    <small class="text-muted d-block">Unique donors</small>
                                    <strong class="fs-5">@r.UniqueDonors.ToString("N0")</strong>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="border rounded p-3 h-100">
                                    <small class="text-muted d-block">Avg donation</small>
                                    <strong class="fs-5">@r.AverageDonation.ToString("C")</strong>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="border rounded p-3 h-100">
                                    <small class="text-muted d-block">Largest donation</small>
                                    <strong class="fs-5">@r.LargestDonation.ToString("C")</strong>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="border rounded p-3 h-100">
                                    <small class="text-muted d-block">Total campaigns</small>
                                    <strong class="fs-5">@r.TotalCampaigns.ToString("N0")</strong>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="border rounded p-3 h-100">
                                    <small class="text-muted d-block">New in period</small>
                                    <strong class="fs-5">@r.NewCampaignsInPeriod.ToString("N0")</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Visualisations -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">Visualisations</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <small class="text-muted">Daily totals</small>
                                <canvas id="chartDaily" height="110"></canvas>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted">By status</small>
                                <canvas id="chartStatus" height="180"></canvas>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted">By category (raised)</small>
                                <canvas id="chartCategory" height="180"></canvas>
                            </div>
                            <div class="col-12">
                                <small class="text-muted">Top campaigns (top 10 by raised)</small>
                                <canvas id="chartTopCampaigns" height="180"></canvas>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted">By payment method (raised)</small>
                                <canvas id="chartPayment" height="180"></canvas>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted">Top donors (top 10 by total given)</small>
                                <canvas id="chartTopDonors" height="180"></canvas>
                            </div>
                            <div class="col-12">
                                <small class="text-muted">By location (raised)</small>
                                <canvas id="chartLocation" height="160"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <script id="report-data-daily"    type="application/json">@Html.Raw(dailyJson)</script>
                <script id="report-data-status"   type="application/json">@Html.Raw(statusJson)</script>
                <script id="report-data-category" type="application/json">@Html.Raw(categoryJson)</script>
                <script id="report-data-topcamp"  type="application/json">@Html.Raw(topCampJson)</script>
                <script id="report-data-payment"  type="application/json">@Html.Raw(paymentJson)</script>
                <script id="report-data-donors"   type="application/json">@Html.Raw(donorsJson)</script>
                <script id="report-data-location" type="application/json">@Html.Raw(locationJson)</script>

                <!-- By status -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">By campaign status</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Status</th>
                                    <th class="text-end">Campaigns</th>
                                    <th class="text-end">Donations</th>
                                    <th class="text-end">Total raised</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (r.ByStatus.Count == 0)
                                {
                                    <tr><td colspan="4" class="text-center text-muted">No data.</td></tr>
                                }
                                else
                                {
                                    foreach (var s in r.ByStatus)
                                    {
                                        <tr>
                                            <td>@s.Status</td>
                                            <td class="text-end">@s.CampaignCount.ToString("N0")</td>
                                            <td class="text-end">@s.DonationCount.ToString("N0")</td>
                                            <td class="text-end">@s.TotalRaised.ToString("C")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Top campaigns -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">Top campaigns (by raised)</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Campaign</th>
                                    <th>Status</th>
                                    <th class="text-end">Donations</th>
                                    <th class="text-end">Total raised</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (r.TopCampaigns.Count == 0)
                                {
                                    <tr><td colspan="4" class="text-center text-muted">No donations in range.</td></tr>
                                }
                                else
                                {
                                    foreach (var t in r.TopCampaigns)
                                    {
                                        <tr>
                                            <td>@t.Title</td>
                                            <td><span class="badge bg-light text-dark">@t.Status</span></td>
                                            <td class="text-end">@t.DonationCount.ToString("N0")</td>
                                            <td class="text-end">@t.TotalRaised.ToString("C")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- By payment method -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">By payment method</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Payment method</th>
                                    <th class="text-end">Donations</th>
                                    <th class="text-end">Total raised</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (r.ByPaymentMethod.Count == 0)
                                {
                                    <tr><td colspan="3" class="text-center text-muted">No data.</td></tr>
                                }
                                else
                                {
                                    foreach (var p in r.ByPaymentMethod)
                                    {
                                        <tr>
                                            <td>@p.PaymentMethod</td>
                                            <td class="text-end">@p.DonationCount.ToString("N0")</td>
                                            <td class="text-end">@p.TotalRaised.ToString("C")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Top donors -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">Top donors</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Donor</th>
                                    <th class="text-end">Donations</th>
                                    <th class="text-end">Total given</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (r.TopDonors.Count == 0)
                                {
                                    <tr><td colspan="3" class="text-center text-muted">No donations in range.</td></tr>
                                }
                                else
                                {
                                    foreach (var d in r.TopDonors)
                                    {
                                        <tr>
                                            <td>@d.DonorLabel</td>
                                            <td class="text-end">@d.DonationCount.ToString("N0")</td>
                                            <td class="text-end">@d.TotalGiven.ToString("C")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- By location -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">By location</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Location</th>
                                    <th class="text-end">Campaigns</th>
                                    <th class="text-end">Donations</th>
                                    <th class="text-end">Total raised</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (r.ByLocation.Count == 0)
                                {
                                    <tr><td colspan="4" class="text-center text-muted">No data.</td></tr>
                                }
                                else
                                {
                                    foreach (var l in r.ByLocation)
                                    {
                                        <tr>
                                            <td>@l.Location</td>
                                            <td class="text-end">@l.CampaignCount.ToString("N0")</td>
                                            <td class="text-end">@l.DonationCount.ToString("N0")</td>
                                            <td class="text-end">@l.TotalRaised.ToString("C")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Campaign progress -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">Campaign progress</h6>
                        <small class="text-muted">@r.CampaignProgress.Count campaign(s)</small>
                    </div>
                    <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Campaign</th>
                                    <th>Status</th>
                                    <th class="text-end">Goal</th>
                                    <th class="text-end">Raised</th>
                                    <th style="min-width:120px;">% funded</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (r.CampaignProgress.Count == 0)
                                {
                                    <tr><td colspan="5" class="text-center text-muted">No data.</td></tr>
                                }
                                else
                                {
                                    foreach (var p in r.CampaignProgress)
                                    {
                                        var pctClamped = Math.Min(100m, Math.Max(0m, p.PercentFunded));
                                        <tr>
                                            <td>@p.Title</td>
                                            <td><span class="badge bg-light text-dark">@p.Status</span></td>
                                            <td class="text-end">@p.FundingGoal.ToString("C")</td>
                                            <td class="text-end">@p.CurrentAmount.ToString("C")</td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress flex-grow-1" style="height:6px;">
                                                        <div class="progress-bar bg-success" role="progressbar"
                                                             style="width:@pctClamped.ToString("F0")%;"
                                                             aria-valuenow="@pctClamped.ToString("F0")"
                                                             aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                    <small class="text-muted" style="min-width:48px;">@p.PercentFunded.ToString("F1")%</small>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Daily totals -->
                <div class="card shadow-sm">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">Daily totals</h6>
                        <small class="text-muted">@r.DailyTotals.Count day(s) with activity</small>
                    </div>
                    <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Date</th>
                                    <th class="text-end">Donations</th>
                                    <th class="text-end">Total raised</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (r.DailyTotals.Count == 0)
                                {
                                    <tr><td colspan="3" class="text-center text-muted">No donations in range.</td></tr>
                                }
                                else
                                {
                                    foreach (var d in r.DailyTotals)
                                    {
                                        <tr>
                                            <td>@d.Date.ToString("yyyy-MM-dd")</td>
                                            <td class="text-end">@d.DonationCount.ToString("N0")</td>
                                            <td class="text-end">@d.TotalRaised.ToString("C")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (Model.PreviewReport is not null)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>
            (function () {
                function readJson(id) {
                    var el = document.getElementById(id);
                    if (!el) return null;
                    try { return JSON.parse(el.textContent || "[]"); }
                    catch (e) { return null; }
                }

                var fmtCurrency = function (v) {
                    return new Intl.NumberFormat(undefined, { style: 'currency', currency: 'USD' }).format(v);
                };

                var palette = [
                    '#4e79a7', '#f28e2b', '#e15759', '#76b7b2', '#59a14f',
                    '#edc949', '#af7aa1', '#ff9da7', '#9c755f', '#bab0ab'
                ];

                // ---- Daily totals (line + bar combo) ----
                var daily = readJson('report-data-daily') || [];
                if (daily.length) {
                    new Chart(document.getElementById('chartDaily'), {
                        data: {
                            labels: daily.map(function (d) { return d.date; }),
                            datasets: [
                                {
                                    type: 'line',
                                    label: 'Raised',
                                    data: daily.map(function (d) { return Number(d.raised); }),
                                    borderColor: palette[0],
                                    backgroundColor: 'rgba(78, 121, 167, 0.15)',
                                    fill: true,
                                    tension: 0.25,
                                    yAxisID: 'yMoney'
                                },
                                {
                                    type: 'bar',
                                    label: 'Donations',
                                    data: daily.map(function (d) { return d.donations; }),
                                    backgroundColor: palette[1] + 'cc',
                                    yAxisID: 'yCount'
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            interaction: { mode: 'index', intersect: false },
                            scales: {
                                yMoney: {
                                    type: 'linear', position: 'left', beginAtZero: true,
                                    ticks: { callback: function (v) { return fmtCurrency(v); } }
                                },
                                yCount: {
                                    type: 'linear', position: 'right', beginAtZero: true,
                                    grid: { drawOnChartArea: false }
                                }
                            },
                            plugins: {
                                tooltip: {
                                    callbacks: {
                                        label: function (ctx) {
                                            if (ctx.dataset.label === 'Raised') {
                                                return 'Raised: ' + fmtCurrency(ctx.parsed.y);
                                            }
                                            return 'Donations: ' + ctx.parsed.y;
                                        }
                                    }
                                }
                            }
                        }
                    });
                }

                // ---- By status (stacked bar: campaigns vs donations counts) ----
                var status = readJson('report-data-status') || [];
                if (status.length) {
                    new Chart(document.getElementById('chartStatus'), {
                        type: 'bar',
                        data: {
                            labels: status.map(function (s) { return s.status; }),
                            datasets: [
                                {
                                    label: 'Campaigns',
                                    data: status.map(function (s) { return s.campaignCount; }),
                                    backgroundColor: palette[0]
                                },
                                {
                                    label: 'Donations',
                                    data: status.map(function (s) { return s.donationCount; }),
                                    backgroundColor: palette[2]
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            scales: {
                                x: { stacked: true },
                                y: { stacked: true, beginAtZero: true }
                            },
                            plugins: {
                                tooltip: {
                                    callbacks: {
                                        afterBody: function (items) {
                                            var idx = items[0].dataIndex;
                                            var s = status[idx];
                                            return ['Raised: ' + fmtCurrency(s.totalRaised)];
                                        }
                                    }
                                }
                            }
                        }
                    });
                }

                // ---- By category (doughnut of raised) ----
                var category = readJson('report-data-category') || [];
                var categoryActive = category.filter(function (c) { return Number(c.totalRaised) > 0; });
                if (categoryActive.length) {
                    new Chart(document.getElementById('chartCategory'), {
                        type: 'doughnut',
                        data: {
                            labels: categoryActive.map(function (c) { return c.category; }),
                            datasets: [{
                                data: categoryActive.map(function (c) { return Number(c.totalRaised); }),
                                backgroundColor: categoryActive.map(function (_, i) {
                                    return palette[i % palette.length];
                                })
                            }]
                        },
                        options: {
                            responsive: true,
                            plugins: {
                                tooltip: {
                                    callbacks: {
                                        label: function (ctx) {
                                            return ctx.label + ': ' + fmtCurrency(ctx.parsed);
                                        }
                                    }
                                },
                                legend: { position: 'right' }
                            }
                        }
                    });
                }

                // ---- Top campaigns (horizontal bar, top 10) ----
                var top = readJson('report-data-topcamp') || [];
                if (top.length) {
                    new Chart(document.getElementById('chartTopCampaigns'), {
                        type: 'bar',
                        data: {
                            labels: top.map(function (t) {
                                return t.title.length > 40 ? t.title.slice(0, 37) + '...' : t.title;
                            }),
                            datasets: [{
                                label: 'Raised',
                                data: top.map(function (t) { return Number(t.totalRaised); }),
                                backgroundColor: palette[4]
                            }]
                        },
                        options: {
                            indexAxis: 'y',
                            responsive: true,
                            scales: {
                                x: {
                                    beginAtZero: true,
                                    ticks: { callback: function (v) { return fmtCurrency(v); } }
                                }
                            },
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function (ctx) {
                                            return 'Raised: ' + fmtCurrency(ctx.parsed.x);
                                        }
                                    }
                                }
                            }
                        }
                    });
                }

                // ---- By payment method (pie of raised) ----
                var payment = readJson('report-data-payment') || [];
                var paymentActive = payment.filter(function (p) { return Number(p.totalRaised) > 0; });
                if (paymentActive.length) {
                    new Chart(document.getElementById('chartPayment'), {
                        type: 'pie',
                        data: {
                            labels: paymentActive.map(function (p) { return p.paymentMethod; }),
                            datasets: [{
                                data: paymentActive.map(function (p) { return Number(p.totalRaised); }),
                                backgroundColor: paymentActive.map(function (_, i) {
                                    return palette[i % palette.length];
                                })
                            }]
                        },
                        options: {
                            responsive: true,
                            plugins: {
                                tooltip: {
                                    callbacks: {
                                        label: function (ctx) {
                                            return ctx.label + ': ' + fmtCurrency(ctx.parsed);
                                        }
                                    }
                                },
                                legend: { position: 'right' }
                            }
                        }
                    });
                }

                // ---- Top donors (horizontal bar, top 10 by total given) ----
                var donors = readJson('report-data-donors') || [];
                if (donors.length) {
                    new Chart(document.getElementById('chartTopDonors'), {
                        type: 'bar',
                        data: {
                            labels: donors.map(function (d) {
                                return d.donorLabel.length > 28 ? d.donorLabel.slice(0, 25) + '...' : d.donorLabel;
                            }),
                            datasets: [{
                                label: 'Total given',
                                data: donors.map(function (d) { return Number(d.totalGiven); }),
                                backgroundColor: palette[6]
                            }]
                        },
                        options: {
                            indexAxis: 'y',
                            responsive: true,
                            scales: {
                                x: {
                                    beginAtZero: true,
                                    ticks: { callback: function (v) { return fmtCurrency(v); } }
                                }
                            },
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function (ctx) {
                                            return 'Given: ' + fmtCurrency(ctx.parsed.x);
                                        }
                                    }
                                }
                            }
                        }
                    });
                }

                // ---- By location (horizontal bar of raised) ----
                var location = readJson('report-data-location') || [];
                var locationActive = location.filter(function (l) {
                    return Number(l.totalRaised) > 0 || Number(l.campaignCount) > 0;
                });
                if (locationActive.length) {
                    new Chart(document.getElementById('chartLocation'), {
                        type: 'bar',
                        data: {
                            labels: locationActive.map(function (l) { return l.location; }),
                            datasets: [{
                                label: 'Total raised',
                                data: locationActive.map(function (l) { return Number(l.totalRaised); }),
                                backgroundColor: palette[3]
                            }]
                        },
                        options: {
                            indexAxis: 'y',
                            responsive: true,
                            scales: {
                                x: {
                                    beginAtZero: true,
                                    ticks: { callback: function (v) { return fmtCurrency(v); } }
                                }
                            },
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function (ctx) {
                                            var l = locationActive[ctx.dataIndex];
                                            return [
                                                'Raised: ' + fmtCurrency(ctx.parsed.x),
                                                'Campaigns: ' + l.campaignCount,
                                                'Donations: ' + l.donationCount
                                            ];
                                        }
                                    }
                                }
                            }
                        }
                    });
                }
            })();
        </script>
    }
}
