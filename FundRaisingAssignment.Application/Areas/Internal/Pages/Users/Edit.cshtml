@page "{id:guid}"
@model FundRaisingAssignment.Application.Areas.Internal.Pages.Users.EditModel
@{
    ViewData["Title"] = "Edit User";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="Index">Users</a></li>
        <li class="breadcrumb-item active">Edit</li>
    </ol>
</nav>
<h2 class="mb-4">Edit User</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-body">
                <form method="post">
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    }
                    <input asp-for="Input.Id" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Role" class="form-label"></label>
                        <select asp-for="Input.Role" asp-items="Model.RoleOptions" class="form-select"></select>
                        <span asp-validation-for="Input.Role" class="text-danger small"></span>
                    </div>

                    <p class="text-muted small">Joined: @Model.Input.JoinDate.ToString("dd MMM yyyy")</p>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <a asp-page="Index" class="btn btn-outline-secondary ms-auto">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Lock / Unlock panel -->
        <div class="card border-@(Model.IsLockedOut ? "danger" : "success")">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <strong>Account Status: </strong>
                    @if (Model.IsLockedOut)
                    {
                        <span class="text-danger">Locked Out</span>
                    }
                    else
                    {
                        <span class="text-success">Active</span>
                    }
                </div>
                @if (Model.IsLockedOut)
                {
                    <form method="post" asp-page-handler="Unlock">
                        <input type="hidden" name="id" value="@Model.Input.Id" />
                        <button type="submit" class="btn btn-success btn-sm">Unlock</button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="Lock"
                          onsubmit="return confirm('Lock out this user?')">
                        <input type="hidden" name="id" value="@Model.Input.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">Lock Out</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}