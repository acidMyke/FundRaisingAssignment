@page "{id:guid}"
@model FundRaisingAssignment.Application.Areas.Internal.Pages.Users.DeleteModel
@{
    ViewData["Title"] = "Remove User";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="Index">Users</a></li>
        <li class="breadcrumb-item active">Remove</li>
    </ol>
</nav>
<h2 class="mb-4">Remove User</h2>

<div class="row">
    <div class="col-md-5">
        <div class="card border-danger">
            <div class="card-body">
                <p><strong>Username:</strong> @Model.UserName</p>
                <p><strong>Email:</strong> @Model.Email</p>

                <div class="alert alert-warning">
                    <strong>Choose an action:</strong>
                    <ul class="mb-0 mt-1">
                        <li><strong>Lock Out</strong> – blocks login, keeps all data intact.</li>
                        <li><strong>Permanently Delete</strong> – removes the account. Cannot be undone.</li>
                    </ul>
                </div>

                <div class="d-flex flex-column gap-2 mt-3">
                    <form method="post" asp-page-handler="Lock">
                        <input type="hidden" name="id" value="@Model.UserId" />
                        <button type="submit" class="btn btn-warning w-100">Lock Out Account</button>
                    </form>
                    <form method="post" asp-page-handler="Delete"
                          onsubmit="return confirm('Permanently delete this user? This cannot be undone.')">
                        <input type="hidden" name="id" value="@Model.UserId" />
                        <button type="submit" class="btn btn-danger w-100">Permanently Delete</button>
                    </form>
                    <a asp-page="Index" class="btn btn-outline-secondary w-100">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</div>