@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="d-flex justify-content-center" style="padding: 24px 16px 64px;">
  <div class="card" style="width:100%;max-width:440px;border-radius:16px;border:1px solid #e2e8f0;box-shadow:0 4px 16px rgba(15,23,42,0.05);">
    <div class="card-body" style="padding: 36px 32px;">
      <div class="text-center mb-4">
        <partial name="_Brand" model="@("lg")"/>
        <h1 class="mt-3 mb-1" style="font-size:1.6rem;font-weight:700;letter-spacing:-0.02em;">Welcome back</h1>
        <p class="text-muted mb-0" style="font-size:0.95rem;">Log in to your GiveHive account.</p>
      </div>

      <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

        <div class="form-floating mb-3">
          <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com"/>
          <label asp-for="Input.Email">Email</label>
          <span asp-validation-for="Input.Email" class="text-danger small"></span>
        </div>

        <div class="form-floating mb-3 position-relative">
          <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" id="loginPwField"/>
          <label asp-for="Input.Password">Password</label>
          <button type="button" class="pw-toggle btn btn-link p-1" data-pw-target="loginPwField" aria-label="Show password"
                  style="position:absolute;top:50%;right:8px;transform:translateY(-50%);color:#64748b;text-decoration:none;line-height:0;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-eye"><path d="M2 12C3.5 7.5 7.5 5 12 5s8.5 2.5 10 7c-1.5 4.5-5.5 7-10 7s-8.5-2.5-10-7Z" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-eye-off" style="display:none;"><path d="M3 3l18 18M10.6 10.6a2 2 0 102.8 2.8M9 5.6A10 10 0 0112 5c4.5 0 8.5 2.5 10 7-.4 1.2-1 2.3-1.7 3.3M6.4 6.4C4.5 7.7 3 9.7 2 12c1.5 4.5 5.5 7 10 7 1.4 0 2.8-.3 4-.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>
          <span asp-validation-for="Input.Password" class="text-danger small"></span>
        </div>

        <div class="form-check mb-3">
          <input class="form-check-input" asp-for="Input.RememberMe"/>
          <label class="form-check-label" asp-for="Input.RememberMe">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
        </div>

        <button id="login-submit" type="submit" class="btn btn-primary w-100 fw-semibold" style="padding:0.65rem;">Log in</button>

        <div class="text-center small mt-3" style="line-height:1.8;">
          <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none">Forgot your password?</a><br/>
          <span class="text-muted">New here? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-medium">Create an account</a></span>
        </div>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
          <hr class="my-3"/>
          <p class="text-center text-muted small mb-2">or continue with</p>
          <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div class="d-flex flex-wrap gap-2 justify-content-center">
              @foreach (var provider in Model.ExternalLogins!)
              {
                <button type="submit" class="btn btn-outline-secondary btn-sm" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
              }
            </div>
          </form>
        }
      </form>

      <div class="text-center text-muted small mt-3 d-flex align-items-center justify-content-center gap-2">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;"><path d="M8 1.5L13.5 4V8.5C13.5 11.5 11 13.7 8 14.5C5 13.7 2.5 11.5 2.5 8.5V4L8 1.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M5.5 8L7.2 9.7L10.5 6.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Your connection is encrypted.</span>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial"/>
  <script>
    document.querySelectorAll('.pw-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const input = document.getElementById(btn.dataset.pwTarget);
        if (!input) return;
        const showing = input.type === 'text';
        input.type = showing ? 'password' : 'text';
        btn.querySelector('.icon-eye').style.display = showing ? '' : 'none';
        btn.querySelector('.icon-eye-off').style.display = showing ? 'none' : '';
        btn.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
      });
    });
  </script>
}
