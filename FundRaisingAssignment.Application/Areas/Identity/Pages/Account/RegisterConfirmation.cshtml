@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirm your email";
}

<div class="d-flex justify-content-center" style="padding: 24px 16px 64px;">
  <div class="card" style="width:100%;max-width:480px;border-radius:16px;border:1px solid #e2e8f0;box-shadow:0 4px 16px rgba(15,23,42,0.05);">
    <div class="card-body" style="padding: 36px 32px;">
      <div class="text-center mb-4">
        <partial name="_Brand" model="@("lg")"/>
        <div style="width:56px;height:56px;border-radius:14px;background:linear-gradient(135deg,rgba(16,185,129,0.12),rgba(79,70,229,0.12));display:inline-flex;align-items:center;justify-content:center;margin:24px auto 16px;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 7L12 13L21 7" stroke="#4f46e5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="3" y="5" width="18" height="14" rx="2" stroke="#4f46e5" stroke-width="1.8"/>
          </svg>
        </div>
        <h1 class="mb-2" style="font-size:1.6rem;font-weight:700;letter-spacing:-0.02em;">Check your inbox</h1>
        @if (!string.IsNullOrEmpty(Model.Email))
        {
          <p class="text-muted mb-0" style="font-size:0.95rem;">
            We've sent a confirmation link to<br/>
            <strong class="text-dark">@Model.Email</strong>
          </p>
        }
        else
        {
          <p class="text-muted mb-0" style="font-size:0.95rem;">We've sent you a confirmation link.</p>
        }
      </div>

      @if (Model.DisplayConfirmAccountLink)
      {
        <div class="alert alert-warning small mb-3" role="alert">
          <strong>Dev mode:</strong> no email sender is configured, so use the link below to confirm.
          <a href="https://aka.ms/aspaccountconf" target="_blank" class="text-decoration-none">Configure email →</a>
        </div>
        <a id="confirm-link" href="@Model.EmailConfirmationUrl" class="btn btn-primary w-100 fw-semibold" style="padding:0.65rem;">
          Confirm my account
        </a>
      }
      else
      {
        <div class="text-center text-muted small mb-3" style="line-height:1.6;">
          Click the link in the email to activate your account. Didn't get it? Check your spam folder, or have us resend it.
        </div>
        <a asp-page="./ResendEmailConfirmation" class="btn btn-outline-primary w-100 fw-semibold" style="padding:0.65rem;">
          Resend confirmation email
        </a>
      }

      <div class="text-center small mt-3 text-muted">
        Already confirmed? <a asp-page="./Login" class="text-decoration-none fw-medium">Log in</a>
      </div>

      <div class="text-center text-muted small mt-3 d-flex align-items-center justify-content-center gap-2">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;"><path d="M8 1.5L13.5 4V8.5C13.5 11.5 11 13.7 8 14.5C5 13.7 2.5 11.5 2.5 8.5V4L8 1.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M5.5 8L7.2 9.7L10.5 6.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Confirmation links expire in 24 hours.</span>
      </div>
    </div>
  </div>
</div>
