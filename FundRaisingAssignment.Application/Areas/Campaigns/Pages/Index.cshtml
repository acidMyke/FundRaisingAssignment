@page
@using FundRaisingAssignment.Application.Extensions
@model FundRaisingAssignment.Application.Areas.Campaigns.Pages.IndexModel
@{
    ViewData["Title"] = "Browse campaigns";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Browse campaigns</h1>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <input type="text" name="Keyword" value="@Model.Keyword" class="form-control"
               placeholder="Search title or description" />
    </div>
    <div class="col-md-3">
        <input type="text" name="Category" value="@Model.Category" class="form-control"
               placeholder="Category" />
    </div>
    <div class="col-md-3">
        <input type="text" name="Location" value="@Model.Location" class="form-control"
               placeholder="Location" />
    </div>
    <div class="col-md-1 d-grid">
        <button type="submit" class="btn btn-success">Search</button>
    </div>
</form>

@{
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Keyword)
                     || !string.IsNullOrWhiteSpace(Model.Category)
                     || !string.IsNullOrWhiteSpace(Model.Location);
}

@if (!Model.Campaigns.Any())
{
    <div class="alert alert-info">
        @(hasFilters
            ? "No active campaigns match your search."
            : "There are no active campaigns to donate to right now. Please check back soon.")
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var campaign in Model.Campaigns)
        {
            var pct = campaign.TargetAmount > 0
                ? (int)Math.Min(100, Math.Round((double)(campaign.CurrentAmount / campaign.TargetAmount) * 100))
                : 0;
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-success-subtle text-success align-self-start mb-2">
                            @campaign.Status.GetDisplayName()
                        </span>
                        <h5 class="card-title">@campaign.Title</h5>
                        <p class="text-muted small">
                            @(string.IsNullOrWhiteSpace(campaign.ShortDescription)
                                ? (campaign.Description.Length > 140
                                    ? campaign.Description[..140] + "…"
                                    : campaign.Description)
                                : campaign.ShortDescription)
                        </p>
                        <div class="mt-auto">
                            <div class="progress mb-2" style="height: 6px;">
                                <div class="progress-bar bg-success" role="progressbar"
                                     style="width: @pct%"
                                     aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <div class="d-flex justify-content-between small text-muted mb-3">
                                <span><strong>@campaign.CurrentAmount.ToString("C")</strong> raised</span>
                                <span>of @campaign.TargetAmount.ToString("C")</span>
                            </div>
                            <a class="btn btn-success w-100"
                               asp-area="Campaigns" asp-page="./Details" asp-route-id="@campaign.Id">
                                View &amp; donate
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
