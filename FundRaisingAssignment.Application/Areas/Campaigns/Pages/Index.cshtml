@page
@using FundRaisingAssignment.Application.Areas.Campaigns.Pages
@using FundRaisingAssignment.Application.Models
@model IndexModel
@{
    ViewData["Title"] = "All Campaigns";
    Layout = "_Layout";
}

<style>
  .hero{text-align:center;padding:40px 20px 28px;}
  .hero h1{font-size:2rem;font-weight:800;color:#0f172a;margin:0 0 8px;}
  .hero p{color:#64748b;font-size:1rem;margin:0;}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px;padding:0 0 40px;}
  .card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;overflow:hidden;display:flex;flex-direction:column;transition:box-shadow .2s;}
  .card:hover{box-shadow:0 8px 30px rgba(0,0,0,.08);}
  .card-img{height:160px;background:#f1f5f9;background-size:cover;background-position:center;}
  .card-body{padding:18px 18px 14px;flex:1;display:flex;flex-direction:column;}
  .cat-pill{background:#eff6ff;color:#3b82f6;padding:2px 8px;border-radius:999px;font-size:.72rem;font-weight:600;display:inline-block;margin-bottom:8px;}
  .card-title{font-size:1rem;font-weight:700;color:#1e293b;margin:0 0 5px;line-height:1.35;}
  .card-sub{color:#64748b;font-size:.82rem;margin:0 0 12px;line-height:1.5;}
  .pb-bg{background:#e2e8f0;border-radius:999px;height:7px;overflow:hidden;margin-bottom:6px;}
  .pb-fg{height:100%;border-radius:999px;background:#4f46e5;}
  .fund-row{display:flex;justify-content:space-between;font-size:.78rem;color:#64748b;margin-bottom:12px;}
  .fund-row strong{color:#1e293b;}
  .card-footer{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #f1f5f9;padding:12px 18px 14px;}
  .days-pill{background:#f8fafc;border:1px solid #e2e8f0;border-radius:999px;padding:3px 10px;font-size:.75rem;color:#475569;}
  .btn-donate{background:#4f46e5;color:#fff;padding:7px 16px;border-radius:7px;font-size:.82rem;font-weight:600;text-decoration:none;transition:background .15s;}
  .btn-donate:hover{background:#4338ca;}
  .rating{color:#f59e0b;font-size:.82rem;}
  .empty{text-align:center;padding:64px 20px;color:#94a3b8;}
</style>

<div class="hero">
  <h1>Browse All Campaigns</h1>
  <p>Support a cause you believe in. Every donation makes a difference.</p>
</div>

@if (!Model.Campaigns.Any())
{
  <div class="empty">
    <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" style="margin-bottom:14px;opacity:.3;">
      <path d="M12 21a9 9 0 100-18 9 9 0 000 18zM12 8v4M12 16h.01"/>
    </svg>
    <h3 style="color:#475569;">No active campaigns right now</h3>
    <p>Check back soon — new campaigns are reviewed and published regularly.</p>
  </div>
}
else
{
  <div class="grid">
    @foreach (var c in Model.Campaigns)
    {
      int daysLeft = Math.Max(0, (c.EndDate.Date - DateTime.Today).Days);
      double pct   = c.FundingGoal > 0
                     ? Math.Min(100, (double)c.CurrentAmount / (double)c.FundingGoal * 100) : 0;

      <div class="card">
        @if (!string.IsNullOrEmpty(c.CoverImageUrl))
        {
          <div class="card-img" style="background-image:url('@c.CoverImageUrl')"></div>
        }
        else
        {
          <div class="card-img" style="background:linear-gradient(135deg,#e0e7ff,#c7d2fe);
               display:flex;align-items:center;justify-content:center;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.3">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
        }
        <div class="card-body">
          <span class="cat-pill">@c.Category</span>
          <h3 class="card-title">@c.Title</h3>
          <p class="card-sub">@c.ShortDescription</p>
          <div class="pb-bg"><div class="pb-fg" style="width:@pct.ToString("F0")%"></div></div>
          <div class="fund-row">
            <span><strong>$@c.CurrentAmount.ToString("N0")</strong> raised</span>
            <span>of $@c.FundingGoal.ToString("N0")</span>
          </div>
          @if (c.ReviewCount > 0)
          {
            <div class="rating">★ @c.AverageRating.ToString("F1") <span style="color:#94a3b8;">(@c.ReviewCount review@(c.ReviewCount==1?"":"s"))</span></div>
          }
        </div>
        <div class="card-footer">
          <span class="days-pill">@daysLeft day@(daysLeft==1?"":"s") left</span>
          <a asp-area="Dashboard" asp-page="/CampaignPage" asp-route-id="@c.Id"
             class="btn-donate">Donate →</a>
        </div>
      </div>
    }
  </div>
}
