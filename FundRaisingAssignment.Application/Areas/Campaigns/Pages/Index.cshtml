@page
@model FundRaisingAssignment.Application.Areas.Campaigns.Pages.IndexModel
@{
    ViewData["Title"] = "Campaign list";
}

<div>
    <h1>Campaign list</h1>

    @if (Model.Campaigns != null && Model.Campaigns.Count > 0)
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Target Amount</th>
                    <th>Current Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var campaign in Model.Campaigns)
            {
                <tr>
                    <td>
                        @campaign.Title
                    </td>
                    <td>@(campaign.ShortDescription ?? campaign.Description)</td>
                    <td>@("$" + campaign.TargetAmount.ToString("N2"))</td>
                    <td>@("$" + campaign.CurrentAmount.ToString("N2"))</td>
                    <td>@campaign.Status</td>
                    <td>
                        <a asp-area="Campaigns" asp-page="/Details" asp-route-id="@campaign.Id" class="btn btn-sm btn-info">View Details</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">No campaigns found.</div>
    }
</div>