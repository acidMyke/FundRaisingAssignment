@page
@using FundRaisingAssignment.Application.Extensions
@model FundRaisingAssignment.Application.Areas.Dashboard.Pages.IndexModel
@{
    ViewData["Title"] = "My campaigns";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My campaigns</h1>
    <a asp-page="./CreateCampaign" class="btn btn-primary">Create Campaign</a>
</div>

@if (Model.Campaigns.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Target Amount</th>
                    <th>Current Amount</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var campaign in Model.Campaigns)
                {
                    <tr>
                        <td>@campaign.Title</td>
                        <td>
                            <span class="badge bg-secondary">@campaign.Status.GetDisplayName()</span>
                        </td>
                        <td>@campaign.TargetAmount.ToString("C")</td>
                        <td>@campaign.CurrentAmount.ToString("C")</td>
                        <td>@campaign.StartDate.ToShortDateString()</td>
                        <td>@(campaign.EndDate?.ToShortDateString() ?? "-")</td>
                        <td>
                            <a asp-page="./UpdateCampaign" asp-route-id="@campaign.Id"
                               class="btn btn-sm btn-outline-primary">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        You have not created any campaigns yet.
    </div>
}