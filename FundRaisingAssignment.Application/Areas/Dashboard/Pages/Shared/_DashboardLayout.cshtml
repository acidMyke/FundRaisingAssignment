@using FundRaisingAssignment.Application.Models
@using Microsoft.AspNetCore.Authorization
@using FundRaisingAssignment.Application.Security
@inject IAuthorizationService AuthorizationService

@{
    Layout = "_Layout";
    var auth = await AuthorizationService.AuthorizeAsync(User, "RequireThreeDaysJoined");
    if (!auth.Succeeded) { IgnoreBody(); IgnoreSection("Scripts"); }

    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool isAdmin = User.IsInRole("Admin");
    bool isPendingFundraiser = User.IsInRole(ApplicationRole.Names.PendingFundraiser)
                             && !User.IsInRole(ApplicationRole.Names.Fundraiser)
                             && !User.IsInRole(ApplicationRole.Names.Admin)
                             && !User.IsInRole(ApplicationRole.Names.PlatformManager);

    string active(string p) => page.Contains(p) ? "active" : "";
}

@if (auth.Succeeded)
{
<style>
  .dash-nav{background:#fff;border-bottom:2px solid #e2e8f0;margin-bottom:24px;}
  .dash-nav-inner{max-width:1200px;margin:0 auto;padding:0 20px;display:flex;align-items:stretch;gap:2px;flex-wrap:wrap;}
  .dash-link{display:inline-flex;align-items:center;gap:5px;padding:12px 16px;font-size:.85rem;font-weight:500;color:#64748b;text-decoration:none;border-bottom:3px solid transparent;transition:color .15s,border-color .15s;white-space:nowrap;}
  .dash-link:hover{color:#1e293b;border-bottom-color:#cbd5e1;}
  .dash-link.active{color:#4f46e5;border-bottom-color:#4f46e5;font-weight:600;}
  .dash-link-admin{color:#92400e;background:#fefce8;}
  .dash-link-admin:hover{color:#78350f;background:#fef9c3;border-bottom-color:#fbbf24;}
  .dash-link-admin.active{color:#92400e;border-bottom-color:#d97706;}
  .dash-link-manage{color:#dc2626;}
  .dash-link-manage:hover{color:#991b1b;border-bottom-color:#fca5a5;}
  .dash-link-manage.active{color:#dc2626;border-bottom-color:#dc2626;}
</style>

<nav class="dash-nav">
  <div class="dash-nav-inner">
    <a asp-area="Dashboard" asp-page="/Campaigns"
       class="dash-link @active("/Campaigns")">
      📋 My Campaigns
    </a>
    @if (!isPendingFundraiser)
    {
      <a asp-area="Dashboard" asp-page="/CreateCampaign"
         class="dash-link @active("/CreateCampaign")">
        ✚ Create Campaign
      </a>
    }
    @if (isAdmin)
    {
      <a asp-area="Dashboard" asp-page="/ManageCampaigns"
         class="dash-link dash-link-manage @active("/ManageCampaigns")">
        ⚙ Manage All Campaigns
      </a>
      <a asp-area="Dashboard" asp-page="/FlaggedCampaigns"
         class="dash-link dash-link-admin @active("/FlaggedCampaigns")">
        ⚑ Flagged Campaigns
      </a>
    }
    @if (User.IsInRole("PlatformManager"))
    {
        <a asp-area="Dashboard" asp-page="/ShowDashboard"
          class="dash-link @active("/ShowDashboard")">
            📊 View Analytics Dashboard
        </a>
    }
  </div>
</nav>

@if (isPendingFundraiser)
{
  <div style="background:#fef3c7;border-bottom:1px solid #fbbf24;padding:10px 20px;display:flex;gap:10px;align-items:center;font-size:.85rem;color:#92400e;">
    <span>⏳</span>
    <span>
      <strong>Your fundraiser account is pending approval.</strong>
      Campaign creation is locked until an Admin approves your application.
      Check the <a asp-area="Internal" asp-page="/FundraiserApprovals"         style="color:#92400e;font-weight:600;">Fundraiser Approvals</a> page if you are an admin.
    </span>
  </div>
}

@RenderBody()
@section Scripts { @RenderSection("Scripts", required: false) }
}
else
{
  <div style="text-align:center;padding:60px 20px;">
    <h1 style="font-size:2rem;font-weight:700;">Access Denied</h1>
    <p style="color:#64748b;margin-top:8px;">You need to be a member for at least 3 days to access this area.</p>
  </div>
}
