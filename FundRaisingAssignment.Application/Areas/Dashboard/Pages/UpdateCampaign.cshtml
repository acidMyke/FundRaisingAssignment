@page "{id:Guid}"
@using FundRaisingAssignment.Application.Models
@model FundRaisingAssignment.Application.Areas.Dashboard.Pages.UpdateCampaignModel
@{
    ViewData["Title"] = "Edit Campaign";
    var categories = Html.GetEnumSelectList<CampaignCategory>();
    var statuses   = Html.GetEnumSelectList<CampaignStatus>()
                        .Where(x => x.Value != CampaignStatus.Flagged.ToString("D")
                                 && x.Value != CampaignStatus.PendingReview.ToString("D"));
}

<div class="page-narrow">
  <div class="page-hero">
    <h1>Edit Campaign</h1>
    <p>Update your campaign details. Funding goal and deadline can also be changed here.</p>
  </div>

  <div class="card">
    <form method="post" novalidate>
      <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

      <div class="form-group">
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="field-error"></span>
      </div>

      <div class="form-group">
        <label asp-for="Input.ShortDescription" class="form-label"></label>
        <input asp-for="Input.ShortDescription" class="form-control" />
        <span asp-validation-for="Input.ShortDescription" class="field-error"></span>
      </div>

      <div class="form-group">
        <label asp-for="Input.Category" class="form-label"></label>
        <select asp-for="Input.Category" asp-items="categories" class="form-control"></select>
        <span asp-validation-for="Input.Category" class="field-error"></span>
      </div>

      <div class="form-group">
        <label asp-for="Input.Location" class="form-label"></label>
        <input asp-for="Input.Location" class="form-control" placeholder="e.g. Singapore" />
        <span asp-validation-for="Input.Location" class="field-error"></span>
      </div>

      <div class="form-group">
        <label asp-for="Input.Description" class="form-label"></label>
        <textarea asp-for="Input.Description" class="form-control" rows="6"></textarea>
        <span asp-validation-for="Input.Description" class="field-error"></span>
      </div>

      <div class="form-group">
        <label asp-for="Input.CoverImageUrl" class="form-label"></label>
        <input asp-for="Input.CoverImageUrl" class="form-control" placeholder="https://…" />
        <span asp-validation-for="Input.CoverImageUrl" class="field-error"></span>
      </div>

      <hr class="divider" />

      <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:var(--space-4);">
        <div class="form-group" style="margin:0;">
          <label asp-for="Input.FundingGoal" class="form-label"></label>
          <div class="input-prefix-group">
            <span class="input-prefix">$</span>
            <input asp-for="Input.FundingGoal" class="form-control" type="number" min="1" step="0.01" />
          </div>
          <span asp-validation-for="Input.FundingGoal" class="field-error"></span>
        </div>

        <div class="form-group" style="margin:0;">
          <label asp-for="Input.EndDate" class="form-label"></label>
          <input asp-for="Input.EndDate" class="form-control" type="date" />
          <span asp-validation-for="Input.EndDate" class="field-error"></span>
        </div>

        <div class="form-group" style="margin:0;">
          <label asp-for="Input.Status" class="form-label"></label>
          <select asp-for="Input.Status" asp-items="statuses" class="form-control"></select>
          <span asp-validation-for="Input.Status" class="field-error"></span>
        </div>
      </div>

      <hr class="divider" />

      <div style="display:flex; gap:var(--space-4); flex-wrap:wrap;">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-area="Dashboard" asp-page="/Campaigns" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
