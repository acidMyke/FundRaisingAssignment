@page
@model FundRaisingAssignment.Application.Areas.Dashboard.Pages.DonationHistoryPageModel
@{
    ViewData["Title"] = "Donation History";
}

<style>
    @@media print {
        body * { visibility: hidden; }
        .receipt-printable, .receipt-printable * { visibility: visible; }
        .receipt-printable { position: absolute; left: 0; top: 0; width: 100%; }
        .no-print { display: none !important; }
    }
</style>

<h1 class="no-print">Donation History</h1>
<hr class="no-print" />
<div class="row">
    <div class="col-md-10">
        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger no-print">@Model.ErrorMessage</div>
        }
        else if (Model.DonationRecords == null || !Model.DonationRecords.Any())
        {
            <div class="no-print">No donation records available.</div>
        }
        else
        {
            <table class="table table-striped no-print">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Campaign</th>
                        <th>Amount</th>
                        <th>Receipt Number</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var record in Model.DonationRecords)
                {
                    <tr>
                        <td>@record.CreatedAt.ToShortDateString()</td>
                        <td>
                            @if (record.Campaign != null)
                            {
                                <a asp-area="Campaigns" asp-page="/Details" asp-route-id="@record.Campaign.Id">
                                    @record.Campaign.Title
                                </a>
                            }
                        </td>
                        <td>@record.Amount.ToString("C")</td>
                        <td>@record.ReceiptNumber</td>
                        <td>
                            <form method="post">
                                <input type="hidden" name="SelectedDonationId" value="@record.Id" />
                                <button type="submit" class="btn btn-primary btn-sm">View Receipt</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }

        @if (Model.SelectedDonation != null)
        {
            <div class="card mt-4 receipt-printable">
                <div class="card-header">
                    <strong>Donation Receipt</strong>
                </div>
                <div class="card-body">
                    <p><strong>Date:</strong> @Model.SelectedDonation.CreatedAt.ToShortDateString()</p>
                    <p><strong>Campaign:</strong> @Model.SelectedDonation.Campaign?.Title</p>
                    <p><strong>Amount:</strong> @Model.SelectedDonation.Amount.ToString("C")</p>
                    <p><strong>Receipt Number:</strong> @Model.SelectedDonation.ReceiptNumber</p>
                    <p><strong>Payment Method:</strong> @Model.SelectedDonation.PaymentMethod</p>
                    @if (!string.IsNullOrEmpty(Model.SelectedDonation.Notes))
                    {
                        <p><strong>Notes:</strong> @Model.SelectedDonation.Notes</p>
                    }
                    <div class="no-print d-flex gap-2">
                        <button type="button" onclick="window.print()" class="btn btn-secondary">Print</button>
                        <form method="post" asp-page-handler="Download">
                            <input type="hidden" name="PrintOrDownloadId" value="@Model.SelectedDonation.Id" />
                            <button type="submit" class="btn btn-success">Download</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
