@page
@model FundRaisingAssignment.Application.Areas.Dashboard.Pages.CreateCampaignModel
@{
    ViewData["Title"] = "Create Campaign";
}

<h1>Create Campaign</h1>

<hr />
<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Input.Title" class="control-label"></label>
                <input asp-for="Input.Title" class="form-control" />
                <span asp-validation-for="Input.Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.ShortDescription" class="control-label"></label>
                <input asp-for="Input.ShortDescription" class="form-control" />
                <span asp-validation-for="Input.ShortDescription" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.Description" class="control-label"></label>
                <textarea asp-for="Input.Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Input.Description" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="Input.StartDate" class="control-label"></label>
                    <input asp-for="Input.StartDate" class="form-control" type="datetime-local" />
                    <span asp-validation-for="Input.StartDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="Input.EndDate" class="control-label"></label>
                    <input asp-for="Input.EndDate" class="form-control" type="datetime-local" />
                    <span asp-validation-for="Input.EndDate" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.TargetAmount" class="control-label"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="Input.TargetAmount" class="form-control" type="number" step="0.01" min="1" />
                </div>
                <span asp-validation-for="Input.TargetAmount" class="text-danger"></span>
            </div>

            <div class="form-group mt-4 mb-5">
                <input type="submit" value="Create Campaign" class="btn btn-primary" />
                <a asp-page="./Index" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
