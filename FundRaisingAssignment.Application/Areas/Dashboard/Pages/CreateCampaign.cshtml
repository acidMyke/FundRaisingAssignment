@page
@using FundRaisingAssignment.Application.Models
@model FundRaisingAssignment.Application.Areas.Dashboard.Pages.CreateCampaignModel
@{
    ViewData["Title"] = "Create Campaign";
    var categories = Html.GetEnumSelectList<CampaignCategory>();
}

<style>
  .cc-accent {
    background: linear-gradient(135deg, #10b981, #4f46e5);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .cc-section-label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #64748b;
    margin: 0 0 14px;
  }
  .cc-form .form-floating > .form-control,
  .cc-form .form-floating > .form-select {
    border-radius: 10px;
    border-color: #e2e8f0;
  }
  .cc-form .form-floating > .form-control:focus,
  .cc-form .form-floating > .form-select:focus {
    border-color: #4f46e5;
    box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.12);
  }
  .cc-form .form-floating > textarea.form-control { min-height: 170px; }
  .cc-btn-primary {
    background: #4f46e5; color: #fff;
    border: 1px solid #4f46e5;
    padding: 0.65rem 1.6rem;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.15s;
  }
  .cc-btn-primary:hover {
    background: #4338ca; border-color: #4338ca;
    color: #fff;
    box-shadow: 0 4px 12px rgba(79, 70, 229, 0.28);
    transform: translateY(-1px);
  }
  .cc-btn-secondary {
    background: #fff; color: #475569;
    border: 1px solid #e2e8f0;
    padding: 0.65rem 1.6rem;
    border-radius: 10px;
    font-weight: 500;
    text-decoration: none;
    display: inline-flex; align-items: center;
  }
  .cc-btn-secondary:hover { border-color: #cbd5e1; color: #1e293b; }
  .cc-tip {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    color: #1e40af;
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 0.85rem;
    margin: 4px 0 20px;
  }
</style>

<div style="max-width:760px;margin:0 auto;padding:8px 16px 64px;">

  <div style="margin-bottom:24px;">
    <a asp-area="Dashboard" asp-page="/Campaigns"
       style="text-decoration:none;color:#64748b;font-size:0.88rem;display:inline-block;margin-bottom:8px;">
      ← My Campaigns
    </a>
    <h1 style="font-size:1.85rem;font-weight:800;letter-spacing:-0.025em;margin:0 0 6px;">
      Start a new <span class="cc-accent">campaign</span>
    </h1>
    <p class="text-muted" style="font-size:1rem;margin:0;line-height:1.55;max-width:48ch;">
      Tell donors your story, set a goal, and start raising funds. Your campaign will be reviewed before going live.
    </p>
  </div>

  <div class="card cc-form" style="border-radius:16px;border:1px solid #e2e8f0;box-shadow:0 4px 16px rgba(15,23,42,0.04);">
    <div class="card-body" style="padding:32px;">
      <form method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

        @* Section 1: Story *@
        <div class="mb-4">
          <h2 class="cc-section-label">Tell your story</h2>

          <div class="form-floating mb-3">
            <input asp-for="Input.Title" class="form-control" placeholder="Campaign title" maxlength="100"/>
            <label asp-for="Input.Title">Campaign title</label>
            <span asp-validation-for="Input.Title" class="text-danger small"></span>
          </div>

          <div class="form-floating mb-1">
            <input asp-for="Input.ShortDescription" class="form-control" placeholder="One-sentence tagline" maxlength="200"/>
            <label asp-for="Input.ShortDescription">Short description</label>
            <span asp-validation-for="Input.ShortDescription" class="text-danger small"></span>
          </div>
          <div class="form-text small mb-3" style="color:#64748b;">Shown in listings and search results.</div>

          <div class="form-floating mb-3">
            <select asp-for="Input.Category" asp-items="categories" class="form-select"></select>
            <label asp-for="Input.Category">Category</label>
            <span asp-validation-for="Input.Category" class="text-danger small"></span>
          </div>

          <div class="form-floating mb-1">
            <input asp-for="Input.Location" class="form-control" placeholder="e.g. Singapore" maxlength="100"/>
            <label asp-for="Input.Location">Location <span class="text-muted">(optional)</span></label>
            <span asp-validation-for="Input.Location" class="text-danger small"></span>
          </div>
          <div class="form-text small mb-3" style="color:#64748b;">Helps donors find local campaigns when they search by location.</div>

          <div class="form-floating mb-1">
            <textarea asp-for="Input.Description" class="form-control" placeholder="Full description"></textarea>
            <label asp-for="Input.Description">Full description / purpose</label>
            <span asp-validation-for="Input.Description" class="text-danger small"></span>
          </div>
          <div class="form-text small mb-3" style="color:#64748b;">Describe your campaign purpose, how funds will be used, and who benefits.</div>

          <div class="form-floating">
            <input asp-for="Input.CoverImageUrl" class="form-control" placeholder="https://example.com/image.jpg"/>
            <label asp-for="Input.CoverImageUrl">Cover image URL <span class="text-muted">(optional)</span></label>
            <span asp-validation-for="Input.CoverImageUrl" class="text-danger small"></span>
          </div>
        </div>

        <hr class="my-4" style="border-color:#f1f5f9;"/>

        @* Section 2: Funding *@
        <div class="mb-4">
          <h2 class="cc-section-label">Funding details</h2>

          <div class="row g-3">
            <div class="col-md-6">
              <div class="form-floating">
                <input asp-for="Input.FundingGoal" class="form-control" type="number" min="1" step="0.01" placeholder="5000"/>
                <label asp-for="Input.FundingGoal">Funding goal (USD)</label>
                <span asp-validation-for="Input.FundingGoal" class="text-danger small"></span>
              </div>
              <div class="form-text small" style="color:#64748b;">Total amount you need to raise.</div>
            </div>

            <div class="col-md-6">
              <div class="form-floating">
                <input asp-for="Input.EndDate" class="form-control" type="date"/>
                <label asp-for="Input.EndDate">Funding deadline</label>
                <span asp-validation-for="Input.EndDate" class="text-danger small"></span>
              </div>
              <div class="form-text small" style="color:#64748b;">Campaign countdown ends on this date.</div>
            </div>
          </div>
        </div>

        <div class="cc-tip">
          <strong>Heads up:</strong> Campaigns start as a Draft. Submit for review when you're ready, and admins will publish it.
        </div>

        <div class="d-flex gap-2 flex-wrap">
          <button type="submit" class="cc-btn-primary">Create campaign →</button>
          <a asp-area="Dashboard" asp-page="/Campaigns" class="cc-btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial"/>
}
