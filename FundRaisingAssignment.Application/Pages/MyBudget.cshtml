@page
@using FundRaisingAssignment.Application.Models
@model FundRaisingAssignment.Application.Pages.MyBudgetModel
@{
    ViewData["Title"] = "My Budget & Goal";
}

@*
    Page bound to MyBudgetModel.
    Uses two POST handlers via asp-page-handler:
        Save  → OnPostSaveAsync
        Clear → OnPostClearAsync
*@

<div class="container py-4">

    <!-- ===================== Page header ===================== -->
    <div class="d-flex justify-content-between align-items-end mb-4 pb-3 border-bottom">
        <div>
            <small class="text-uppercase text-muted fw-semibold">Donee · Donation goal</small>
            <h1 class="mt-2 mb-1">My Budget &amp; Target</h1>
            <p class="text-muted mb-0">Set how much you plan to give and track progress over time.</p>
        </div>
    </div>

    <!-- ===================== Flash message ===================== -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">

        <!-- ===================== Left: form ===================== -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white border-bottom-0 pt-3">
                    <h5 class="mb-0">Goal settings</h5>
                </div>
                <div class="card-body">
                    @* Validation summary catches non-field errors *@
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <form method="post">
                        @* @Html.AntiForgeryToken() is added automatically by Razor Pages *@

                        <!-- Budget limit -->
                        <div class="mb-3">
                            <label asp-for="Input.BudgetLimit" class="form-label fw-medium"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Input.BudgetLimit"
                                       type="number" step="0.01" min="0"
                                       class="form-control" placeholder="500.00" />
                            </div>
                            <span asp-validation-for="Input.BudgetLimit" class="text-danger small"></span>
                            <div class="form-text">Maximum amount you intend to donate over the period.</div>
                        </div>

                        <!-- Target amount -->
                        <div class="mb-3">
                            <label asp-for="Input.TargetAmount" class="form-label fw-medium"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Input.TargetAmount"
                                       type="number" step="0.01" min="0"
                                       class="form-control" placeholder="300.00" />
                            </div>
                            <span asp-validation-for="Input.TargetAmount" class="text-danger small"></span>
                            <div class="form-text">A goal to motivate your giving — independent of your budget.</div>
                        </div>

                        <!-- Tracking period -->
                        <div class="mb-4">
                            <label asp-for="Input.Period" class="form-label fw-medium"></label>
                            <select asp-for="Input.Period"
                                    asp-items="Html.GetEnumSelectList<GoalPeriod>()"
                                    class="form-select"></select>
                            <div class="form-text">Window the budget &amp; target apply to.</div>
                        </div>

                        <!-- Action buttons (different page handlers) -->
                        <div class="d-flex gap-2">
                            <button type="submit" asp-page-handler="Save" class="btn btn-primary">
                                Save settings
                            </button>
                            <button type="submit" asp-page-handler="Clear" class="btn btn-outline-secondary"
                                    onclick="return confirm('Remove your saved goal?');">
                                Clear
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- ===================== Right: status cards ===================== -->
        <div class="col-lg-6">

            <!-- Budget status card -->
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <small class="text-uppercase text-muted fw-semibold">Budget status</small>
                    <h4 class="mt-1 mb-3">@BudgetHeadline()</h4>

                    @if (Model.Status.BudgetLimit is > 0)
                    {
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-muted">Donated</span>
                            <span>
                                <strong>@Model.Status.TotalDonated.ToString("C")</strong>
                                <span class="text-muted">/ @Model.Status.BudgetLimit.Value.ToString("C")</span>
                            </span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar @BudgetBarClass()"
                                 role="progressbar"
                                 style="width: @(Math.Min(100m, Model.Status.BudgetUsedPercent))%"
                                 aria-valuenow="@Model.Status.BudgetUsedPercent"
                                 aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <p class="small text-muted mt-2 mb-0">@BudgetMeta()</p>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">No budget set yet — fill in the form to start tracking.</p>
                    }
                </div>
            </div>

            <!-- Target status card -->
            <div class="card shadow-sm">
                <div class="card-body">
                    <small class="text-uppercase text-muted fw-semibold">Target progress</small>
                    <h4 class="mt-1 mb-3">@TargetHeadline()</h4>

                    @if (Model.Status.TargetAmount is > 0)
                    {
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-muted">Toward target</span>
                            <span>
                                <strong>@Model.Status.TotalDonated.ToString("C")</strong>
                                <span class="text-muted">/ @Model.Status.TargetAmount.Value.ToString("C")</span>
                            </span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-success"
                                 role="progressbar"
                                 style="width: @(Math.Min(100m, Model.Status.TargetReachedPercent))%"
                                 aria-valuenow="@Model.Status.TargetReachedPercent"
                                 aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <p class="small text-muted mt-2 mb-0">@TargetMeta()</p>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">No target set.</p>
                    }
                </div>
            </div>

            @* Period footer — shows the window being tracked *@
            @if (Model.Status.PeriodStart.HasValue && Model.Status.PeriodEnd.HasValue)
            {
                <p class="small text-muted mt-3 mb-0">
                    Tracking @Model.Status.Period.ToString().ToLowerInvariant():
                    @Model.Status.PeriodStart.Value.ToString("d MMM yyyy")
                    – @Model.Status.PeriodEnd.Value.AddDays(-1).ToString("d MMM yyyy")
                    · @Model.Status.DonationCount donation@(Model.Status.DonationCount == 1 ? "" : "s") counted
                </p>
            }
            else
            {
                <p class="small text-muted mt-3 mb-0">
                    Tracking lifetime · @Model.Status.DonationCount donation@(Model.Status.DonationCount == 1 ? "" : "s") counted
                </p>
            }

        </div>
    </div>
</div>

@*
    Functions block — pure presentation helpers that read from Model.Status
    and produce display strings. Putting them here (not in PageModel) keeps
    the .cshtml.cs file focused on data + business logic.
*@
@functions {
    string BudgetHeadline() => Model.Status.BudgetStatus switch
    {
        BudgetStatus.NotSet       => "Set a budget to begin",
        BudgetStatus.WithinBudget => "Within budget",
        BudgetStatus.NearLimit    => "Approaching limit",
        BudgetStatus.Reached      => "Budget reached",
        BudgetStatus.Exceeded     => "Over budget",
        _ => ""
    };

    string BudgetBarClass() => Model.Status.BudgetStatus switch
    {
        BudgetStatus.Exceeded                            => "bg-danger",
        BudgetStatus.NearLimit or BudgetStatus.Reached   => "bg-warning",
        _                                                => "bg-primary"
    };

    string BudgetMeta()
    {
        if (Model.Status.BudgetLimit is null) return "";
        var limit = Model.Status.BudgetLimit.Value;
        var total = Model.Status.TotalDonated;

        if (total > limit)
            return $"You've exceeded your budget by {(total - limit):C}.";
        if (total == limit)
            return "You've reached your budget cap exactly.";

        var remaining = limit - total;
        return $"{Model.Status.BudgetUsedPercent:0.#}% of budget used. {remaining:C} remaining.";
    }

    string TargetHeadline() => Model.Status.TargetStatus switch
    {
        TargetStatus.NotSet        => "No target set",
        TargetStatus.FarFromTarget => "Far from target",
        TargetStatus.InProgress    => "In progress",
        TargetStatus.NearTarget    => "Near target",
        TargetStatus.Achieved      => "Target achieved 🎉",
        _ => ""
    };

    string TargetMeta()
    {
        if (Model.Status.TargetAmount is null) return "";
        var target = Model.Status.TargetAmount.Value;
        var total  = Model.Status.TotalDonated;

        if (total >= target)
            return $"You've donated {total:C} — beyond your {target:C} target.";

        var remaining = target - total;
        return $"{Model.Status.TargetReachedPercent:0.#}% of target reached. {remaining:C} to go.";
    }
}

@* Validation scripts — enables client-side validation for the form *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
