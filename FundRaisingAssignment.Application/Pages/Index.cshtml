@page
@{
    ViewData["Title"] = "Home";
}

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    padding: 88px 24px 96px;
    margin: 16px 0 56px;
    background:
      radial-gradient(circle at 12% 10%, rgba(16, 185, 129, 0.18), transparent 40%),
      radial-gradient(circle at 88% 90%, rgba(79, 70, 229, 0.18), transparent 40%),
      linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
    border: 1px solid var(--brand-border);
  }
  .hero-inner { max-width: 760px; margin: 0 auto; text-align: center; position: relative; z-index: 1; }
  .hero .brand-xl { margin-bottom: 28px; }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--brand-text);
    margin: 0 0 18px;
  }
  .hero h1 .accent {
    background: linear-gradient(135deg, var(--brand-accent), var(--brand-primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-tagline {
    color: var(--brand-muted);
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 540px;
    margin: 0 auto 36px;
  }
  .hero-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-brand {
    background: var(--brand-primary);
    color: #fff;
    padding: 13px 28px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border: 1px solid var(--brand-primary);
    transition: all 0.15s;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
  }
  .btn-brand:hover { background: var(--brand-primary-dark); border-color: var(--brand-primary-dark); color: #fff; transform: translateY(-1px); box-shadow: 0 4px 8px rgba(79, 70, 229, 0.25); }
  .btn-ghost {
    background: var(--brand-surface);
    color: var(--brand-text);
    padding: 13px 28px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border: 1px solid var(--brand-border);
    transition: all 0.15s;
  }
  .btn-ghost:hover { border-color: var(--brand-primary); color: var(--brand-primary); }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin: 0 0 64px;
  }
  .stat {
    background: var(--brand-surface);
    border: 1px solid var(--brand-border);
    border-radius: 14px;
    padding: 24px;
    text-align: center;
  }
  .stat-num {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, var(--brand-accent), var(--brand-primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    margin-bottom: 6px;
  }
  .stat-label { font-size: 0.85rem; color: var(--brand-muted); font-weight: 500; }

  .section-head { text-align: center; margin: 0 0 40px; }
  .section-head h2 { font-size: 1.85rem; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 10px; }
  .section-head p { color: var(--brand-muted); font-size: 1rem; max-width: 540px; margin: 0 auto; }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin: 0 0 72px;
  }
  .feat {
    background: var(--brand-surface);
    border: 1px solid var(--brand-border);
    border-radius: 14px;
    padding: 28px 24px;
    transition: all 0.2s;
  }
  .feat:hover { border-color: var(--brand-primary); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(79, 70, 229, 0.1); }
  .feat-icon {
    width: 44px; height: 44px;
    border-radius: 11px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem;
    margin-bottom: 16px;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(79, 70, 229, 0.1));
  }
  .feat h3 { font-size: 1rem; font-weight: 700; color: var(--brand-text); margin: 0 0 8px; }
  .feat p { font-size: 0.9rem; color: var(--brand-muted); margin: 0; line-height: 1.55; }

  .closing-cta {
    background: linear-gradient(135deg, var(--brand-primary), #6366f1);
    border-radius: 20px;
    padding: 56px 24px;
    text-align: center;
    margin: 0 0 56px;
  }
  .closing-cta h2 { color: #fff; font-size: 1.85rem; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 12px; }
  .closing-cta p { color: rgba(255, 255, 255, 0.85); font-size: 1rem; margin: 0 0 28px; }
  .closing-cta .btn-brand { background: #fff; color: var(--brand-primary); border-color: #fff; }
  .closing-cta .btn-brand:hover { background: #f8fafc; color: var(--brand-primary-dark); }
</style>

<section class="hero">
  <div class="hero-inner">
    <partial name="_Brand" model="@("xl")"/>
    <h1>Fund the change<br/><span class="accent">you want to see</span></h1>
    <p class="hero-tagline">A transparent fundraising platform where every campaign is reviewed before going live, and donors are protected at every step.</p>
    <div class="hero-cta">
      <a asp-area="Campaigns" asp-page="/Index" class="btn-brand">Browse Campaigns</a>
      @if (User.Identity?.IsAuthenticated == true)
      {
        <a asp-area="Dashboard" asp-page="/CreateCampaign" class="btn-ghost">Start a Campaign</a>
      }
      else
      {
        <a href="/Identity/Account/Register" class="btn-ghost">Get Started</a>
      }
    </div>
  </div>
</section>

<div class="stats">
  <div class="stat">
    <div class="stat-num">100%</div>
    <div class="stat-label">Reviewed campaigns</div>
  </div>
  <div class="stat">
    <div class="stat-num">24h</div>
    <div class="stat-label">Average review time</div>
  </div>
  <div class="stat">
    <div class="stat-num">0%</div>
    <div class="stat-label">Platform fees</div>
  </div>
  <div class="stat">
    <div class="stat-num">★ 4.8</div>
    <div class="stat-label">Donor confidence</div>
  </div>
</div>

<div class="section-head">
  <h2>Why donors trust us</h2>
  <p>Every feature is built around transparency, accountability, and donor protection.</p>
</div>

<div class="features">
  <div class="feat">
    <div class="feat-icon">🛡️</div>
    <h3>Verified Campaigns</h3>
    <p>Every campaign is reviewed by our platform team before donors can see it.</p>
  </div>
  <div class="feat">
    <div class="feat-icon">⭐</div>
    <h3>Donor Reviews</h3>
    <p>Star ratings drive accountability. Campaigns with ≤2-star reviews are auto-flagged.</p>
  </div>
  <div class="feat">
    <div class="feat-icon">📊</div>
    <h3>Live Progress</h3>
    <p>Real-time fundraising progress with countdown timers and donor activity feeds.</p>
  </div>
  <div class="feat">
    <div class="feat-icon">🧾</div>
    <h3>Receipt PDFs</h3>
    <p>Every donation generates a downloadable receipt for your records and taxes.</p>
  </div>
  <div class="feat">
    <div class="feat-icon">↩️</div>
    <h3>Refund Protection</h3>
    <p>Admins can issue refunds with full audit trail if a campaign turns out to be problematic.</p>
  </div>
  <div class="feat">
    <div class="feat-icon">🔔</div>
    <h3>Smart Notifications</h3>
    <p>Fundraisers get notified of every review decision so they're never left guessing.</p>
  </div>
</div>

<div class="closing-cta">
  <h2>Ready to start fundraising?</h2>
  <p>Create your campaign in minutes and reach donors who care.</p>
  @if (User.Identity?.IsAuthenticated == true)
  {
    <a asp-area="Dashboard" asp-page="/CreateCampaign" class="btn-brand">Start a Campaign</a>
  }
  else
  {
    <a href="/Identity/Account/Register" class="btn-brand">Create an Account</a>
  }
</div>
