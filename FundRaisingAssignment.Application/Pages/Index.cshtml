@page
@{
    ViewData["Title"] = "Home";
}

<style>
  .home-hero{text-align:center;padding:64px 20px 48px;}
  .home-hero h1{font-size:2.4rem;font-weight:800;color:#0f172a;margin:0 0 12px;}
  .home-hero p{color:#64748b;font-size:1.05rem;max-width:520px;margin:0 auto 28px;}
  .hero-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;}
  .btn-primary{background:#4f46e5;color:#fff;padding:12px 26px;border-radius:9px;font-weight:700;font-size:.95rem;text-decoration:none;transition:background .15s;}
  .btn-primary:hover{background:#4338ca;color:#fff;}
  .btn-outline{background:#fff;color:#4f46e5;padding:12px 26px;border-radius:9px;font-weight:700;font-size:.95rem;text-decoration:none;border:2px solid #4f46e5;transition:background .15s;}
  .btn-outline:hover{background:#eff6ff;}
  .features{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px;padding:0 0 48px;}
  .feat{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:22px;text-align:center;}
  .feat-icon{font-size:2rem;margin-bottom:10px;}
  .feat h3{font-size:.95rem;font-weight:700;color:#1e293b;margin:0 0 5px;}
  .feat p{font-size:.82rem;color:#64748b;margin:0;}
  .divider{border:none;border-top:1px solid #f1f5f9;margin:0 0 32px;}
</style>

<div class="home-hero">
  <h1>Fund the change<br/>you want to see</h1>
  <p>A transparent fundraising platform where every campaign is reviewed before going live.</p>
  <div class="hero-btns">
    <a asp-area="Campaigns" asp-page="/Index" class="btn-primary">🔍 Browse Campaigns</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
      <a asp-area="Dashboard" asp-page="/CreateCampaign" class="btn-outline">✚ Start a Campaign</a>
    }
    else
    {
      <a href="/Identity/Account/Register" class="btn-outline">Get Started</a>
    }
  </div>
</div>

<hr class="divider"/>

<div class="features">
  <div class="feat">
    <div class="feat-icon">🛡️</div>
    <h3>Verified Campaigns</h3>
    <p>Every campaign is reviewed by our platform team before donors can see it.</p>
  </div>
  <div class="feat">
    <div class="feat-icon">⭐</div>
    <h3>Donor Reviews</h3>
    <p>Donors leave star ratings. Campaigns with poor ratings are flagged automatically.</p>
  </div>
  <div class="feat">
    <div class="feat-icon">💚</div>
    <h3>Transparent Progress</h3>
    <p>Real-time fundraising progress with countdown timers and donor activity.</p>
  </div>
  <div class="feat">
    <div class="feat-icon">🔔</div>
    <h3>Fundraiser Notifications</h3>
    <p>Campaign owners are notified of every review decision by platform management.</p>
  </div>
</div>
