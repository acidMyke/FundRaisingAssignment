@model string
@{
    var size = string.IsNullOrEmpty(Model) ? "md" : Model;
    var (markPx, fontPx) = size switch
    {
        "sm" => (22, 16),
        "lg" => (48, 28),
        "xl" => (64, 36),
        _    => (28, 18)
    };
}
<span class="brand brand-@size" style="display:inline-flex;align-items:center;gap:10px;font-weight:700;line-height:1;">
    <span class="brand-mark" aria-hidden="true" style="display:inline-flex;flex-shrink:0;width:@(markPx)px;height:@(markPx)px;">
        <svg width="@markPx" height="@markPx" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:block;">
            <path d="M16 1.5 L29.5 8.75 L29.5 23.25 L16 30.5 L2.5 23.25 L2.5 8.75 Z" fill="url(#hiveGrad)"/>
            <path d="M16 11 C 17.5 9 20.5 9.3 21.6 11.5 C 22.7 13.7 21.3 16.4 16 20.5 C 10.7 16.4 9.3 13.7 10.4 11.5 C 11.5 9.3 14.5 9 16 11 Z" fill="#fff"/>
            <defs>
                <linearGradient id="hiveGrad" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="#10b981"/>
                    <stop offset="100%" stop-color="#4f46e5"/>
                </linearGradient>
            </defs>
        </svg>
    </span>
    <span class="brand-name" style="font-size:@(fontPx)px;letter-spacing:-0.02em;">GiveHive</span>
</span>
