<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - FundRaiser</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/FundRaisingAssignment.Application.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">🌱 FundRaiser</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="Campaigns" asp-page="/Index">All Campaigns</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Dashboard" asp-page="/Campaigns">My Campaigns</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Dashboard" asp-page="/DonationHistoryPage">Donation History</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/MyBudget">My Budget</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-semibold" asp-area="Dashboard" asp-page="/ManageCampaigns">⚙ Manage Campaigns</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Internal" asp-page="/Index">Internal</a>
                            </li>
                        }
                    }
                </ul>
                <partial name="_LoginPartial"/>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">@RenderBody()</main>
</div>
<footer class="border-top footer text-muted">
    <div class="container" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;padding:12px 0;">
        <span>&copy; 2026 FundRaiser Platform</span>
        <div style="display:flex;gap:16px;font-size:.85rem;">
            <a asp-area="Campaigns" asp-page="/Index" style="color:#6366f1;text-decoration:none;">Browse Campaigns</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-area="Dashboard" asp-page="/CreateCampaign" style="color:#6366f1;text-decoration:none;">Start a Campaign</a>
            }
        </div>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
